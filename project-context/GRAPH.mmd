        SRC -->|inventories| RESUME_SOURCE
        AUTHORED["content/portfolio.ts / owner-authorized SRC-11"] --> LOAD["loadPortfolio / publication validation"]
        LOAD -->|validated owner content| PARSE
        AUTHORED -->|owner-approved data| APP
        ROUTES["app/routes.ts / shared pathname resolution"] --> APP
        ROUTES --> BUILDENTRY
        APP --> RESUME["features/resume / page and timeline"]
        APP --> PROJECTS["features/projects / catalogue and details"]
        APP --> STATUS["app/StatusPage / exploration status and not found"]
        LAYOUT --> NOTICE["Draft notice and ordinary-link navigation"]
        ROUTES --> ROUTETEST["Node route and content-loader tests"]
        BUILDENTRY --> SSRTEST["Node static-page and component-render tests"]
        FIXTURES -->|test-only injection| SSRTEST
        DIST --> SSRTEST
        QUERIES --> RESUME
        QUERIES --> APP
    end


    subgraph Prototype["Phase 4 and 5 procedural journey / DEC-016 and DEC-017"]
        APP --> EXP_PAGE["features/explore/pages/ExplorePage.tsx"]
        PARSED --> EXP_WORLD["world/buildWorld.ts / pure descriptors"]
        EXP_WORLD --> EXP_UI["PrototypeExplorer / HTML controls and chapter content"]
        EXP_PAGE --> EXP_UI
        EXP_UI --> EXP_STATE["useExplorer / pure experience reducer"]
        EXP_URL["state/selection.ts / query ownership and history"] --> EXP_STATE
        EXP_STATE --> EXP_GATE["ExplorerViewport / lazy import and error boundary"]
        EXP_GATE --> EXP_SCENE["scene/PrototypeScene.tsx / Canvas"]
        EXP_SCENE -->|readiness and intent| EXP_STATE
        R3F["Pinned Three.js / React Three Fiber"] --> EXP_SCENE
        EXP_SCENE --> EXP_PROXY["ChapterScene / PlanetOverview / Character proxy"]
        EXP_MOVE["world/movement.ts / bounds and collisions"] --> EXP_PROXY
        EXP_UI --> EXP_PANEL["ProjectPanel / focus, Escape and full detail link"]
        EXP_PROXY -->|selection| EXP_PANEL
        EXP_STATE --> EXP_TEST["Node descriptor, content-evolution, movement, travel and URL tests"]
        EXP_WORLD --> EXP_TEST
        EXP_MOVE --> EXP_TEST
        EXP_SCENE --> EXP_BROWSER["Installed Chrome / isolated software-WebGL behavior QA"]
        DIST --> EXP_BROWSER
        INDEX --> EXP_DOC["areas/exploration.md / prototype contract"]
        EXP_DOC -->|documents| EXP_STATE
    end


    subgraph Observatory["Phase 5 Observatory / DEC-017 / CON-008"]
        APP --> OBS_PAGE["features/observatory/pages/ObservatoryPage.tsx"]
        OBS_PAGE --> OBS_HUB["ObservatoryHub / shared HTML rooms"]
        EXP_UI --> OBS_HUB
        PARSED --> OBS_HUB
        OBS_HUB -->|reuses| RESUME
        OBS_HUB -->|reuses project cards| PROJECTS
        OBS_HUB --> OBS_SKILLS["SkillConstellation / authored skill references"]
        OBS_HUB --> OBS_FUTURE["Future Room / aspirational empty state"]
        EXP_SCENE --> OBS_SCENE["scene/ObservatoryScene.tsx / procedural hub"]
        OBS_SCENE -->|room intent focuses| OBS_HUB
        OBS_SCENE -->|chapter intent| EXP_STATE
        EXP_URL -->|separate hub view| OBS_SCENE
        EXP_WORLD --> EXP_NAV["world/navigation.ts / ordered neighbors and portal proximity"]
        EXP_NAV --> EXP_PROXY
        EXP_PRESETS["world/presets.ts / five authored styles and generic fallback"] --> EXP_WORLD
        ROUTES -->|generates static route| OBS_PAGE
        CON_008 -->|implemented through| OBS_HUB
        INDEX --> OBS_DOC["areas/observatory.md"]
        OBS_DOC -->|owns hub contract| OBS_HUB
    end

    DOMAIN -->|defines| CON_001
    ARCH -->|specifies target| BUILDER
    DATA -->|defines career contract for target| MODEL
    FLOW -->|defines planned behavior| CONTROL
    ARCH -->|records current implementation| APP
    SRC -->|preserved in| GIT["Local Git milestones / DEC-011, DEC-013 and DEC-017"]
    APP -->|versioned in| GIT
