        FIXTURES["__fixtures__/portfolio.ts / synthetic draft only"] --> UNIT["Node domain tests"]
        PARSE --> UNIT
        QUERIES --> UNIT
        DATA -->|owns contract documentation| TYPES
    end


    subgraph Accessible["Phase 3 draft information UI / DEC-014 and DEC-015"]
